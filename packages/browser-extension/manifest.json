{
  "manifest_version": 3,
  "name": "Meeting Cost",
  "version": "1.0.0",
  "description": "Shows the combined hourly cost of everyone in a meeting, live and rising, inside Google Calendar and Outlook on the web.",
  "homepage_url": "https://ayoadvisors.github.io/meeting-cost/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://calendar.google.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "js": [
        "src/vendor/meeting-cost-core.js",
        "src/storage.js",
        "src/content/extract.js",
        "src/content/widget.js",
        "src/content/main.js"
      ],
      "css": ["src/content/widget.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "action": {
    "default_title": "Meeting Cost: set hourly rates",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{9b1a4f3e-2c7d-4e6a-8f50-3d2b7c1e9a44}",
      "strict_min_version": "121.0"
    }
  }
}
